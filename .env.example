# =============================================
# ZenSend - Environment Variables
# =============================================
# Copy this file to .env.local and fill in your values
# .env.local is gitignored (never commit real values)

# ---------------------------
# Host & URL Configuration
# ---------------------------

# Full URL of ZenSend service
NEXT_PUBLIC_SITE_URL=https://zentyr.online/zensend

# Base Path for Subpath routing
NEXT_PUBLIC_BASE_PATH=/zensend

# Socket.IO path (matching Nginx reverse proxy)
NEXT_PUBLIC_SOCKET_PATH=/zensend/socket.io
SOCKET_PATH=/zensend/socket.io

# Port (configured for Oracle Ubuntu service)
PORT=3002

# Allowed CORS Origins (comma separated)
ALLOWED_ORIGINS=https://zentyr.online,http://localhost:3000

# ---------------------------
# TURN Server (Optional: Coturn)
# ---------------------------
TURN_SERVER_URL=turn:161.118.239.92:3478
TURN_USERNAME=zensend
TURN_CREDENTIAL=YOUR_TURN_PASSWORD

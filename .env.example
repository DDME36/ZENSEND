# =============================================
# ZenSend - Environment Variables
# =============================================
# Copy this file to .env.local and fill in your values
# .env.local is gitignored (never commit real values)

# ---------------------------
# Frontend (Vercel)
# ---------------------------

# URL ของ Vercel frontend เช่น https://zensend.vercel.app
NEXT_PUBLIC_SITE_URL=https://zensend.vercel.app

# URL ของ Signaling Server (Oracle backend)
# ถ้าใช้ IP ตรงๆ: http://152.x.x.x:3001
# ถ้ามี domain: https://api.yourdomain.com
NEXT_PUBLIC_SIGNALING_URL=http://YOUR_ORACLE_IP:3001

# ---------------------------
# TURN Server (Oracle Coturn)
# ใส่เพื่อให้ส่งไฟล์ผ่าน NAT/Firewall ได้
# ถ้าไม่มีจะใช้แค่ STUN (อาจส่งไม่ได้ผ่าน 4G/mobile)
# ---------------------------

TURN_SERVER_URL=turn:YOUR_ORACLE_IP:3478
TURN_USERNAME=zensend
TURN_CREDENTIAL=YOUR_TURN_PASSWORD

# ==============================================================================
# ZenSend (Zend by Zentyr) - Environment Configuration
# ==============================================================================

# --- FRONTEND (Vercel) Environment Variables ---
# The public URL of your Signaling Server on Oracle Cloud Ubuntu
# Leave empty for local development (will connect to localhost automatically)
NEXT_PUBLIC_SIGNALING_URL=https://api.yourdomain.com

# Site URL for metadata and OpenGraph
NEXT_PUBLIC_SITE_URL=https://zensend.zentyr.com

# Dedicated Oracle Cloud Coturn TURN/STUN Server
# Run deploy/coturn-setup.sh on your Oracle Cloud VM to generate these:
TURN_SERVER_URL=turn:YOUR_ORACLE_PUBLIC_IP:3478
TURN_USERNAME=zensend
TURN_CREDENTIAL=your_secure_password

# Optional: Discord Webhook for feedback modal
DISCORD_WEBHOOK_URL=

# Disable Next.js Telemetry
NEXT_TELEMETRY_DISABLED=1

# --- BACKEND (Oracle Cloud Ubuntu) Environment Variables ---
PORT=3001
NODE_ENV=production

# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=https://zensend.zentyr.com,https://your-app.vercel.app,http://localhost:3000

# Set to true only if deploying on Render Free Tier (not needed on Oracle Cloud)
ENABLE_RENDER_KEEPALIVE=false
